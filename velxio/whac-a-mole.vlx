  "group-esp32-devkit-c-v4": [
   {
    "name": "main.py",
    "content": "from machine import Pin\nimport radio\nimport time\n\nJOGADOR = 1\nleds = [Pin(12, Pin.OUT), Pin(27, Pin.OUT), Pin(25, Pin.OUT)]\nbuttons = [Pin(13, Pin.IN, Pin.PULL_UP), Pin(14, Pin.IN, Pin.PULL_UP), Pin(26, Pin.IN, Pin.PULL_UP)]\n\nbotao_apertado = -1\nultimo_clique = 0\n\n\ndef acender_led(index):\n    for posicao, led in enumerate(leds):\n        led.value(1 if posicao == index else 0)\n\n\ndef trata_botao(pin):\n    global botao_apertado, ultimo_clique\n\n    for index, btn in enumerate(buttons):\n        if btn == pin:\n            agora = time.ticks_ms()\n            if time.ticks_diff(agora, ultimo_clique) < 200:\n                return\n            ultimo_clique = agora\n            botao_apertado = index\n            return\n\n\nfor btn in buttons:\n    btn.irq(trigger=Pin.IRQ_FALLING, handler=trata_botao)\n\nacender_led(255)\nradio.conectar(JOGADOR)\n\nwhile True:\n    if botao_apertado >= 0:\n        radio.enviar_botao(JOGADOR, botao_apertado)\n        botao_apertado = -1\n\n    index = radio.receber()\n    if index is not None:\n        acender_led(index)\n    time.sleep_ms(5)\n"
   },
   {
    "name": "radio.py",
    "content": "import network\nimport time\n\nSIMULADOR = True\nSALA = b\"whac-a-mole-7f3k9q\"\nTODOS = bytes([255] * 6)\n\nconexao = None\ntopico_estado = None\nrecebidas = []\n\n\ndef chegou(origem, mensagem):\n    recebidas.append(bytes(mensagem))\n\n\ndef conectar(jogador):\n    global conexao, topico_estado\n\n    wifi = network.WLAN(network.STA_IF)\n    wifi.active(True)\n\n    if SIMULADOR:\n        from umqtt.simple import MQTTClient\n\n        wifi.connect(\"Velxio-GUEST\", \"\")\n        while not wifi.isconnected():\n            time.sleep_ms(200)\n\n        prefixo = SALA + b\"/\"\n        topico_estado = prefixo + b\"estado\"\n        conexao = MQTTClient(SALA + b\"-jogador\" + bytes([48 + jogador]), \"broker.hivemq.com\")\n        conexao.set_callback(chegou)\n        conexao.connect()\n        conexao.sock.setsockopt(6, 1, 1)\n        conexao.subscribe(topico_estado)\n    else:\n        import espnow\n\n        conexao = espnow.ESPNow()\n        conexao.active(True)\n        conexao.add_peer(TODOS)\n\n\ndef enviar_botao(jogador, index):\n    pacote = bytes([0x10, jogador, index])\n    try:\n        if SIMULADOR:\n            conexao.publish(SALA + b\"/jogador\" + bytes([48 + jogador]) + b\"/botao\", pacote)\n        else:\n            conexao.send(TODOS, pacote, False)\n    except OSError:\n        pass\n\n\ndef receber():\n    try:\n        if SIMULADOR:\n            conexao.check_msg()\n        else:\n            origem, mensagem = conexao.recv(0)\n            if mensagem:\n                recebidas.append(bytes(mensagem))\n    except OSError:\n        pass\n\n    if recebidas:\n        mensagem = recebidas.pop(0)\n        if len(mensagem) >= 2 and mensagem[0] == 0x20:\n            return mensagem[1]\n    return None\n"
   }
  ],
