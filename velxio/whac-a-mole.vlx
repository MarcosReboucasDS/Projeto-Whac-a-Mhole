  "group-esp32-devkit-c-v4-3": [
   {
    "name": "main.py",
    "content": "import radio\nimport tela\nimport time\nimport random\n\nPONTOS_PARA_VENCER = 10\nAPAGADO = 255\n\npontos = [0, 0]\nled_atual = APAGADO\nultimo_envio = -1\nultimo_clique = [0, 0]\nacertou = 0\nesmagou = 0\napertou = False\n\n\ndef atualizar_display(mensagem=\"ESMAGA!\"):\n    tela.atualizar_display(mensagem, pontos, led_atual, led_atual, esmagou)\n\n\ndef publicar_estado():\n    global ultimo_envio\n    if ultimo_envio != led_atual:\n        ultimo_envio = led_atual\n        radio.enviar_estado(led_atual)\n\n\ndef apagar_leds():\n    global led_atual\n    led_atual = APAGADO\n    publicar_estado()\n\n\ndef clique(jogador, index):\n    global acertou, esmagou, apertou\n\n    agora = time.ticks_ms()\n    if time.ticks_diff(agora, ultimo_clique[jogador]) < 200:\n        return\n    ultimo_clique[jogador] = agora\n    apertou = True\n\n    if index == led_atual:\n        pontos[jogador] += 1\n        apagar_leds()\n        acertou = jogador + 1\n        esmagou = jogador + 1\n\n\ndef processar_eventos():\n    evento = radio.receber()\n    while evento is not None:\n        jogador, index = evento\n        clique(jogador - 1, index)\n        evento = radio.receber()\n\n\ndef esperar(ms):\n    global acertou\n\n    fim = time.ticks_add(time.ticks_ms(), ms)\n    while time.ticks_diff(fim, time.ticks_ms()) > 0:\n        processar_eventos()\n        if acertou:\n            atualizar_display(\"J{} ACERTOU!\".format(acertou))\n            acertou = 0\n        time.sleep_ms(10)\n\n\ndef jogar():\n    global led_atual, acertou, esmagou, apertou, ultimo_envio\n\n    pontos[0] = 0\n    pontos[1] = 0\n    acertou = 0\n    esmagou = 0\n    apertou = False\n    ultimo_envio = -1\n    apagar_leds()\n\n    for numero in (\"3\", \"2\", \"1\"):\n        tela.mostrar_numero(\"PREPARAR...\", numero)\n        esperar(1000)\n\n    while max(pontos) < PONTOS_PARA_VENCER:\n        anterior = led_atual\n        while led_atual == anterior:\n            led_atual = random.randint(0, 2)\n\n        esmagou = 0\n        publicar_estado()\n        atualizar_display(\"APERTE!\")\n        esperar(max(800, 1500 - max(pontos) * 80))\n\n        apagar_leds()\n        atualizar_display(\"J{} ACERTOU!\".format(esmagou) if esmagou else \"ESMAGA!\")\n        esperar(max(500, 800 - max(pontos) * 30))\n\n    vencedor = 1 if pontos[0] > pontos[1] else 2\n    esmagou = 0\n    atualizar_display(\"J{} VENCEU!\".format(vencedor))\n\n\nradio.conectar()\ntela.desenhar_titulo(\"CONECTANDO...\")\n\nwhile True:\n    jogar()\n    esperar(3000)\n    apertou = False\n    while not apertou:\n        esperar(50)\n"
   },
   {
    "name": "radio.py",
    "content": "import network\nimport time\n\nSIMULADOR = True\nSALA = b\"whac-a-mole-7f3k9q\"\nTODOS = bytes([255] * 6)\n\nconexao = None\nrecebidas = []\n\n\ndef chegou(origem, mensagem):\n    recebidas.append(bytes(mensagem))\n\n\ndef conectar():\n    global conexao\n\n    wifi = network.WLAN(network.STA_IF)\n    wifi.active(True)\n\n    if SIMULADOR:\n        from umqtt.simple import MQTTClient\n\n        wifi.connect(\"Velxio-GUEST\", \"\")\n        while not wifi.isconnected():\n            time.sleep_ms(200)\n\n        conexao = MQTTClient(SALA + b\"-jogo\", \"broker.hivemq.com\")\n        conexao.set_callback(chegou)\n        conexao.connect()\n        conexao.sock.setsockopt(6, 1, 1)\n        conexao.subscribe(SALA + b\"/jogador1/botao\")\n        conexao.subscribe(SALA + b\"/jogador2/botao\")\n    else:\n        import espnow\n\n        conexao = espnow.ESPNow()\n        conexao.active(True)\n        conexao.add_peer(TODOS)\n\n\ndef enviar_estado(index):\n    pacote = bytes([0x20, index])\n    try:\n        if SIMULADOR:\n            conexao.publish(SALA + b\"/estado\", pacote)\n        else:\n            conexao.send(TODOS, pacote, False)\n    except OSError:\n        pass\n\n\ndef receber():\n    try:\n        if SIMULADOR:\n            conexao.check_msg()\n        else:\n            origem, mensagem = conexao.recv(0)\n            if mensagem:\n                recebidas.append(bytes(mensagem))\n    except OSError:\n        pass\n\n    if recebidas:\n        mensagem = recebidas.pop(0)\n        if len(mensagem) >= 3 and mensagem[0] == 0x10:\n            return mensagem[1], mensagem[2]\n    return None\n"
   },
   {
    "name": "tela.py",
    "content": "from machine import Pin, SPI\nimport ili9341\nimport framebuf\nimport gc\n\nspi = SPI(2, baudrate=40000000, sck=Pin(18), mosi=Pin(23), miso=Pin(19))\ndisplay = ili9341.ILI9341(spi, cs=Pin(5, Pin.OUT), dc=Pin(2, Pin.OUT), rst=Pin(4, Pin.OUT))\n\nVAZIO = 0\nTOUPEIRA = 1\nESMAGADA = 2\n\n# converte a cor para o formato que a tela entende\ndef cor(r, g, b):\n    c = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3)\n    return ((c & 0xFF) << 8) | (c >> 8)\n\nPRETO = cor(0, 0, 0)\nBRANCO = cor(255, 255, 255)\nAMARELO = cor(255, 214, 0)\nFUNDO_TITULO = cor(30, 30, 46)\nGRAMA = cor(76, 160, 60)\nGRAMA_ESCURA = cor(52, 120, 44)\nTERRA = cor(50, 30, 18)\nPELO = cor(140, 92, 50)\nPELO_ESCURO = cor(104, 66, 34)\nFOCINHO = cor(240, 150, 160)\nCORES_BOTOES = [cor(230, 40, 40), cor(40, 190, 70), cor(250, 210, 30)]\n\n# desenho de um buraco de 64 x 64, reaproveitado em todos\npixels_buraco = bytearray(64 * 64 * 2)\nburaco = framebuf.FrameBuffer(pixels_buraco, 64, 64, framebuf.RGB565)\n\n# guarda o que já está na tela para não desenhar de novo\ncampo_desenhado = False\ntitulo_desenhado = None\npontos_desenhados = [None, None]\nburacos_desenhados = [[None] * 3, [None] * 3]\n\n# escreve o texto ampliado, com o centro em centro_x\ndef texto_grande(texto, centro_x, y, escala, cor_texto, cor_fundo):\n    largura = len(texto) * 8\n    letras = framebuf.FrameBuffer(bytearray(largura), largura, 8, framebuf.MONO_VLSB)\n    letras.text(texto, 0, 0, 1)\n    pixels = bytearray(largura * escala * 8 * escala * 2)\n    quadro = framebuf.FrameBuffer(pixels, largura * escala, 8 * escala, framebuf.RGB565)\n    quadro.fill(cor_fundo)\n    for coluna in range(largura):\n        for linha in range(8):\n            if letras.pixel(coluna, linha):\n                quadro.fill_rect(coluna * escala, linha * escala, escala, escala, cor_texto)\n    display.desenhar(centro_x - largura * escala // 2, y, largura * escala, 8 * escala, pixels)\n    gc.collect()\n\ndef elipse(centro_x, centro_y, raio_x, raio_y, cor_forma):\n    for linha in range(-raio_y, raio_y + 1):\n        metade = int(raio_x * (1 - (linha * linha) / (raio_y * raio_y)) ** 0.5)\n        buraco.hline(centro_x - metade, centro_y + linha, 2 * metade + 1, cor_forma)\n\n# orelhas, corpo, olhos, focinho e dentes\ndef desenhar_toupeira():\n    elipse(17, 16, 5, 5, PELO_ESCURO)\n    elipse(47, 16, 5, 5, PELO_ESCURO)\n    elipse(32, 30, 17, 18, PELO)\n    buraco.fill_rect(15, 30, 35, 21, PELO)\n    elipse(25, 26, 4, 4, BRANCO)\n    elipse(39, 26, 4, 4, BRANCO)\n    elipse(26, 27, 2, 2, PRETO)\n    elipse(38, 27, 2, 2, PRETO)\n    elipse(32, 35, 5, 3, FOCINHO)\n    buraco.fill_rect(29, 39, 3, 5, BRANCO)\n    buraco.fill_rect(33, 39, 3, 5, BRANCO)\n\n# toupeira achatada com olhos em X e estrelas\ndef desenhar_esmagada():\n    elipse(32, 46, 22, 8, PELO)\n    for x in (22, 36):\n        buraco.line(x, 42, x + 6, 48, PRETO)\n        buraco.line(x + 6, 42, x, 48, PRETO)\n    for x, y in ((12, 22), (32, 12), (52, 22)):\n        buraco.hline(x - 5, y, 11, AMARELO)\n        buraco.vline(x, y - 5, 11, AMARELO)\n        buraco.line(x - 3, y - 3, x + 3, y + 3, AMARELO)\n        buraco.line(x - 3, y + 3, x + 3, y - 3, AMARELO)\n\ndef desenhar_buraco(jogador, index, tipo):\n    # só redesenha o buraco que mudou\n    if buracos_desenhados[jogador][index] == tipo:\n        return\n    buracos_desenhados[jogador][index] = tipo\n\n    buraco.fill(GRAMA)\n    elipse(32, 50, 27, 11, GRAMA_ESCURA)\n    elipse(32, 50, 24, 9, TERRA)\n    if tipo == TOUPEIRA:\n        desenhar_toupeira()\n    elif tipo == ESMAGADA:\n        desenhar_esmagada()\n    display.desenhar(80 + index * 80, 56 + jogador * 106, 64, 64, pixels_buraco)\n\ndef desenhar_titulo(mensagem):\n    global titulo_desenhado\n\n    if titulo_desenhado == mensagem:\n        return\n    titulo_desenhado = mensagem\n    display.preencher(0, 0, 320, 28, FUNDO_TITULO)\n    texto_grande(mensagem, 160, 6, 2, BRANCO, FUNDO_TITULO)\n\n# grama, placar dos dois jogadores e faixas com a cor de cada botão\ndef desenhar_campo():\n    global campo_desenhado\n\n    campo_desenhado = True\n    display.preencher(0, 28, 320, 212, GRAMA)\n    for jogador in range(2):\n        y = 30 + jogador * 106\n        display.preencher(0, y, 64, 100, GRAMA_ESCURA)\n        texto_grande(\"J{}\".format(jogador + 1), 32, y + 16, 2, AMARELO, GRAMA_ESCURA)\n        pontos_desenhados[jogador] = None\n        for index in range(3):\n            display.preencher(88 + index * 80, y + 8, 48, 10, CORES_BOTOES[index])\n            buracos_desenhados[jogador][index] = None\n\ndef atualizar_display(mensagem, pontos, toupeira, esmagada, esmagou):\n    if not campo_desenhado:\n        desenhar_campo()\n    desenhar_titulo(mensagem)\n\n    for jogador in range(2):\n        if pontos_desenhados[jogador] != pontos[jogador]:\n            pontos_desenhados[jogador] = pontos[jogador]\n            display.preencher(0, 74 + jogador * 106, 64, 24, GRAMA_ESCURA)\n            texto_grande(str(pontos[jogador]), 32, 74 + jogador * 106, 3, BRANCO, GRAMA_ESCURA)\n\n        for index in range(3):\n            tipo = VAZIO\n            if index == toupeira:\n                tipo = TOUPEIRA\n            elif index == esmagada and esmagou == jogador + 1:\n                tipo = ESMAGADA\n            desenhar_buraco(jogador, index, tipo)\n\n# contagem antes do jogo começar\ndef mostrar_numero(mensagem, numero):\n    global campo_desenhado\n\n    campo_desenhado = False\n    desenhar_titulo(mensagem)\n    display.preencher(0, 28, 320, 212, GRAMA)\n    texto_grande(numero, 160, 94, 10, BRANCO, GRAMA)\n"
   },
   {
    "name": "ili9341.py",
    "content": "import struct\nimport time\n\n\nclass ILI9341:\n    def __init__(self, spi, cs, dc, rst, rotacao=0x28, largura=320, altura=240):\n        self.spi = spi\n        self.cs = cs\n        self.dc = dc\n        self.rst = rst\n        self.rotacao = rotacao\n        self.largura = largura\n        self.altura = altura\n        self.cs.value(1)\n        self.iniciar()\n\n    def comando(self, codigo, dados=None):\n        self.cs.value(0)\n        self.dc.value(0)\n        self.spi.write(bytes([codigo]))\n        if dados:\n            self.dc.value(1)\n            self.spi.write(dados)\n        self.cs.value(1)\n\n    def iniciar(self):\n        self.rst.value(0)\n        time.sleep_ms(50)\n        self.rst.value(1)\n        time.sleep_ms(150)\n        self.comando(0x01)\n        time.sleep_ms(150)\n        self.comando(0x11)\n        time.sleep_ms(150)\n        self.comando(0x3A, bytes([0x55]))\n        self.comando(0x36, bytes([self.rotacao]))\n        self.comando(0x29)\n\n    def janela(self, x, y, largura, altura):\n        self.comando(0x2A, struct.pack(\">HH\", x, x + largura - 1))\n        self.comando(0x2B, struct.pack(\">HH\", y, y + altura - 1))\n\n    def desenhar(self, x, y, largura, altura, pixels):\n        self.janela(x, y, largura, altura)\n        self.comando(0x2C, pixels)\n\n    def preencher(self, x, y, largura, altura, cor):\n        self.janela(x, y, largura, altura)\n        total = largura * altura\n        bloco = struct.pack(\"<H\", cor) * min(total, 256)\n        self.cs.value(0)\n        self.dc.value(0)\n        self.spi.write(bytes([0x2C]))\n        self.dc.value(1)\n        while total > 0:\n            parte = min(total, 256)\n            self.spi.write(bloco if parte == 256 else bloco[: parte * 2])\n            total -= parte\n        self.cs.value(1)\n"
   }
  ]
 },
